{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kestryl",
  "mainBinaryName": "Kestryl",
  "version": "1.8.2",
  "identifier": "com.kestryl.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzQzRCNzQxRTdCRjJFMUIKUldRYkxyL25RYmZFd3lrWXgwYjZicW0rb0ZmQ2hvTkcwYWJUWHlTODJOSStidC9nSlhFd251UUgK",
      "endpoints": ["https://github.com/HacanAle/Kestryl/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "See and stop what leaves your PC.",
    "publisher": "Kestryl",
    "copyright": "© 2026 Kestryl contributors",
    "homepage": "https://github.com/HacanAle/Kestryl",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "windows/nsis-header.bmp",
        "sidebarImage": "windows/nsis-sidebar.bmp",
        "installerHooks": "windows/installer.nsh"
      }
    }
  }
}
